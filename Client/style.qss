QWidget#MainWindow, QWidget#MainMenu { 
    background-color: #1e1e1e; 
}

QLabel { 
    color: white; 
    font-size: 14px;
}

QLineEdit { 
    padding: 8px; 
    border-radius: 10px; 
    background-color: #2b2b2b; 
    color: white; 
    border: 1px solid #4CAF50; 
    min-width: 180px;
}

QPushButton { 
    background-color: #4a4a4a; 
    color: white; 
    border-radius: 22px; 
    font-weight: bold; 
    font-size: 14px; 
    min-height: 45px; 
    border: none;
    padding: 0px 20px; 
}

QPushButton:hover { 
    background-color: #5a5a5a;
}

QPushButton#playButton, QPushButton#profileButton, QPushButton#exitButton,
QPushButton#createGameButton, QPushButton#joinGameButton, QPushButton#modeBackButton,
QPushButton#confirmJoinButton, QPushButton#startGameButton, QPushButton#closeLobbyButton { 
    min-width: 180px; 
    max-width: 180px;
}

QPushButton#loginButton, QPushButton#registerButton { 
    min-width: 180px; 
    max-width: 16777215px;
}

QPushButton#playButton, QPushButton#createGameButton, QPushButton#joinGameButton, 
QPushButton#confirmJoinButton, QPushButton#startGameButton, QPushButton#registerButton { 
    background-color: #4CAF50;
}

QPushButton#registerButton:hover { 
    background-color: #45a049; 
}

QPushButton#exitButton, QPushButton#backButton, QPushButton#cancelJoinButton, 
QPushButton#lobbyBackButton, QPushButton#modeBackButton, QPushButton#closeLobbyButton { 
    background-color: #D32F2F;
}

QPushButton#loginButton { 
    background-color: #E91E63; 
}

QPushButton#loginButton:hover { 
    background-color: #D81B60;
}

QPushButton#profileButton { 
    background-color: #5C6BC0; 
}

QListWidget { 
    background-color: #2b2b2b; 
    color: white; 
    border-radius: 10px;
    border: 1px solid #4a4a4a; 
}

QWidget#profileCard { 
    background-color: #252525; 
    border: 2px solid #4CAF50; 
    border-radius: 20px;
}


QWidget#chatContainer {
    background-color: rgba(30, 30, 30, 230);
    border-radius: 12px;
    border: 1px solid #444;
}

QLabel#chatTitle {
    color: #00bfff;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 1px;
    padding-bottom: 5px;
    border: none;
}

QTextEdit#chatDisplay {
    background-color: #121212;
    color: #e0e0e0;
    border: 1px solid #333;
    border-radius: 6px;
    font-family: 'Segoe UI', Arial;
    font-size: 12px;
    padding: 5px;
}

#chatDisplay QScrollBar:vertical { border: none; background: #222; width: 8px; }
#chatDisplay QScrollBar::handle:vertical { background: #555; border-radius: 4px; }

QLineEdit#chatInput {
    padding: 8px;
    background: #2a2a2a;
    color: white;
    border: 1px solid #444;
    border-radius: 6px;
    min-width: 50px;
}

QLineEdit#chatInput:focus {
    border: 1px solid #00bfff;
}

QPushButton#sendBtn {
    background-color: #0078d4;
    color: white;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: bold;
    min-height: 30px;
}

QPushButton#sendBtn:hover { background-color: #0086f1; }
QPushButton#sendBtn:pressed { background-color: #005a9e; padding-top: 9px; padding-left: 16px; }

QLabel#statusLabel {
    color: white;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#endTurnButton {
    background-color: #D32F2F;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    font-weight: bold;
}

QWidget#handContainer {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    border-top: 1px solid #444;
}